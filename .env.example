# Copy to .env (git-ignored). Variables are prefixed FREIGHT_ for the pipeline.

# docker compose only
POSTGRES_PASSWORD=change-me

# Local runs (outside Docker)
FREIGHT_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/freight_pipeline
FREIGHT_SOURCE_BASE_URL=http://127.0.0.1:8900

# Mekong Container Lines: "api" (JSON behind the page) or "browser" (render with Playwright)
FREIGHT_MCL_MODE=api
# Use an installed browser instead of Playwright's Chromium, e.g. msedge or chrome
FREIGHT_BROWSER_CHANNEL=

# Publish to the logistics platform (project #1): POST /api/rates/import
FREIGHT_LOGISTICS_API_URL=http://localhost:5080
FREIGHT_LOGISTICS_API_KEY=

# Optional: Slack incoming webhook for failure alerts
FREIGHT_SLACK_WEBHOOK_URL=
